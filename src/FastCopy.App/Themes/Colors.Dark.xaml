<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#262626"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#3A3A3A"/>

    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ControlHoverBackgroundBrush" Color="#383838"/>
    <SolidColorBrush x:Key="ControlPressedBackgroundBrush" Color="#333333"/>
    <SolidColorBrush x:Key="ControlDisabledBackgroundBrush" Color="#262626"/>
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#26456B"/>
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="#2F2F2F"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#ACACAC"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#6E6E6E"/>

    <SolidColorBrush x:Key="AccentFillBrush" Color="#106EBE"/>
    <SolidColorBrush x:Key="AccentFillHoverBrush" Color="#2381D1"/>
    <SolidColorBrush x:Key="AccentFillPressedBrush" Color="#0B5A9E"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#479EF5"/>

    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#6BCB77"/>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FDB944"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#F85149"/>

</ResourceDictionary>
