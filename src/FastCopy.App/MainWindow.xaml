<Window x:Class="FastCopy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FastCopy.App"
        mc:Ignorable="d"
        Title="FastCopy" Width="700" Height="760" MinHeight="640" MinWidth="620"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================== Sources ============================== -->
        <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Sources" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock x:Name="SourcesSummaryText" Grid.Column="1" Style="{StaticResource SecondaryTextStyle}"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <ListBox x:Name="SourcesList" Height="112" SelectionMode="Extended">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Style="{StaticResource IconGhostButtonStyle}" Tag="{Binding}"
                                                Click="RemoveSingleSource_Click" ToolTip="Remove" Margin="6,0,0,0">
                                            <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" StrokeThickness="1.6" Width="8" Height="8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptySourcesText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                   Text="No sources yet. Add files or a folder, or drop them anywhere in this window."
                                   Margin="14,0,50,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Width="118">
                        <Button x:Name="BrowseSourceFileButton" Content="Add Files..." Style="{StaticResource SecondaryButtonStyle}" Click="BrowseSourceFile_Click"/>
                        <Button x:Name="BrowseSourceFolderButton" Content="Add Folder..." Style="{StaticResource SecondaryButtonStyle}" Margin="0,6,0,0" Click="BrowseSourceFolder_Click"/>
                        <Button x:Name="RemoveSourceButton" Content="Remove" Style="{StaticResource SecondaryButtonStyle}" Margin="0,6,0,0" Click="RemoveSource_Click"/>
                        <Button x:Name="ClearSourcesButton" Content="Clear" Style="{StaticResource SecondaryButtonStyle}" Margin="0,6,0,0" Click="ClearSources_Click"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="2" Style="{StaticResource SecondaryTextStyle}" FontStyle="Italic" Margin="0,10,0,0"
                           Text="Pasting (Ctrl+V) or dropping files/folders here replaces the sources above and starts copying right away."/>
            </Grid>
        </Border>

        <!-- ============================== Destination &amp; options ============================== -->
        <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Destination" Style="{StaticResource SectionHeaderStyle}"/>

                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DestinationBox" Grid.Column="0" VerticalContentAlignment="Center"/>
                    <Button x:Name="BrowseDestButton" Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="BrowseDestination_Click"/>
                    <Button x:Name="OpenDestButton" Grid.Column="2" Content="Open" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Click="OpenDestination_Click"/>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <CheckBox x:Name="VerifyCheckBox" Content="Verify after copy (hash compare, slower)" VerticalAlignment="Center"/>
                    <TextBlock Text="If a file already exists:" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="24,0,10,0"/>
                    <ComboBox x:Name="ConflictActionCombo" Width="160" SelectedIndex="0">
                        <ComboBoxItem Content="Overwrite"/>
                        <ComboBoxItem Content="Skip"/>
                        <ComboBoxItem Content="Overwrite if newer"/>
                        <ComboBoxItem Content="Keep both"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== Actions &amp; progress ============================== -->
        <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <Button x:Name="StartButton" Style="{StaticResource PrimaryButtonStyle}" Click="Start_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 0,0 L 8,5 L 0,10 Z" Width="8" Height="10" VerticalAlignment="Center"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Start" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PauseResumeButton" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" IsEnabled="False" Click="PauseResume_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="PauseIcon" Data="M 0,0 L 3,0 L 3,10 L 0,10 Z M 6,0 L 9,0 L 9,10 L 6,10 Z" Width="9" Height="10" VerticalAlignment="Center"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="PauseResumeLabel" Text="Pause" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton" Style="{StaticResource DangerHoverButtonStyle}" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Width="10" Height="10" VerticalAlignment="Center"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Cancel" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ProgressBar x:Name="ProgressBarControl" Grid.Row="1" Minimum="0" Maximum="100" Margin="0,0,0,12"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource StatusHeadlineStyle}"/>
                        <TextBlock x:Name="FileText" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock x:Name="SpeedText" HorizontalAlignment="Right" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextBrush}"/>
                        <TextBlock x:Name="SizeText" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                        <TextBlock x:Name="EtaText" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================== Log ============================== -->
        <Border Grid.Row="3" Style="{StaticResource PanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Log" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
