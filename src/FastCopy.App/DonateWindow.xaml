<Window x:Class="FastCopy.App.DonateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Support FastCopy" Width="460" SizeToContent="Height"
        Icon="Assets/AppIcon.ico"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelStyle}">
            <StackPanel>
                <TextBlock Text="FastCopy is free" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    No licence key, no trial, no locked features. Every part of FastCopy works
                    for everyone, forever.
                </TextBlock>

                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    It is built and maintained by one person in their own time. If it saves you
                    some of yours, a donation of any amount keeps the work going.
                </TextBlock>
            </StackPanel>
        </Border>

        <CheckBox x:Name="DontShowAgainCheckBox" Grid.Row="1" Margin="2,16,0,0"
                  Content="Don't show this again"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="LaterButton" Content="Maybe later" Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True" Click="Later_Click"/>
            <Button x:Name="DonateButton" Content="Donate via PayPal" Style="{StaticResource PrimaryButtonStyle}"
                    Margin="8,0,0,0" IsDefault="True" Click="Donate_Click"/>
        </StackPanel>
    </Grid>
</Window>
